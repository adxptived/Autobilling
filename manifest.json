{
  "manifest_version": 3,
  "name": "Autobilling",
  "version": "1.3.0",
  "description": "Auto-fill bank card forms with generated valid cards. Stripe support.",
  "author": "adxptived",
  "permissions": ["activeTab", "storage", "scripting", "contextMenus"],
  "host_permissions": [
    "https://*.stripe.com/*",
    "https://checkout.stripe.com/*",
    "https://lookup.binlist.net/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Autobilling"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "autofill": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Autofill current Stripe form"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://checkout.stripe.com/*",
        "https://*.stripe.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "autobilling@extension",
      "strict_min_version": "109.0"
    }
  }
}
